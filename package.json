{
  "name": "spiritfire-dawn",
  "private": true,
  "version": "0.1.0",
  "description": "灵火破晓 — 浏览器 FPS 肉鸽（Three.js + TypeScript + Vite）",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:labs": "tsc --noEmit && vite build --mode labs",
    "typecheck": "tsc --noEmit",
    "unity:web:sync": "python art/tools/export_unity_weapon_web.py",
    "unity:web:maps": "bash scripts/unity/bridge.sh webexport",
    "unity:web:publish": "node scripts/unity/optimize-web-levels.mjs",
    "test:scrolls": "node --test tests/scroll-tactics.test.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "preview": "vite preview",
    "whitebox:sync": "node scripts/level-plans/sync-runtime.mjs",
    "level:atlas": "node scripts/level-plans/build.mjs && node scripts/level-plans/build.mjs --v2",
    "whitebox:check": "node scripts/level-plans/sync-runtime.mjs --check && node --test tests/whitebox-layout.test.mjs tests/whitebox-flow.test.mjs tests/whitebox-save.test.mjs tests/whitebox-redesign.test.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
